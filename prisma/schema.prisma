generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  plan      String    @default("free")
  settings  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users                User[]
  agents               Agent[]
  tools                Tool[]
  agentToolPermissions AgentToolPermission[]
  toolExecutions       ToolExecution[]
  auditEvents          AuditEvent[]

  @@map("tenants")
}

model User {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              String    @default("member")
  isVerified        Boolean   @default(false) @map("is_verified")
  verificationToken String?   @map("verification_token")
  refreshTokenHash  String?   @map("refresh_token_hash")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([refreshTokenHash])
  @@index([verificationToken])
  @@map("users")
}

model Agent {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  name         String
  description  String?
  apiKeyId     String    @unique @map("api_key_id")
  apiKeyHash   String    @map("api_key_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastActiveAt DateTime? @map("last_active_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions AgentToolPermission[]

  @@unique([tenantId, name])
  @@index([tenantId]) // even though the composite index can be used for tenantId lookups, this index is added separately around tenantId to improve query performance for lookups cz tenantId based lookup is a common use case
  @@map("agents")
}

model Tool {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  category      String?
  handlerType   String   @map("handler_type")
  handlerConfig String   @map("handler_config") // ciphertext: "iv:ciphertext:authTag"
  inputSchema   Json     @map("input_schema")
  outputSchema  Json?    @map("output_schema")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions AgentToolPermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tools")
}

model AgentToolPermission {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  agentId  String  @map("agent_id")
  toolId   String  @map("tool_id")
  isActive Boolean @default(true) @map("is_active")

  // ── Phase 2 stub columns ──────────────────────────────────────────
  // NOT read or enforced by ANY Week 3 code path. They exist now
  // purely to avoid a schema migration later (PRD §10 already lists
  // both on this table). Treat a non-null value here as INERT until
  // the Phase 2 authorization engine (PRD §8) is actually built.
  // Delete this comment block the day enforcement lands — not
  // before, or a future reader will assume these are already checked.
  parameterConstraints Json? @map("parameter_constraints")
  callBudgetPerHour    Int?  @map("call_budget_per_hour")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  // agentId and toolId each already belong to exactly one tenant via
  // their own FK chains — so this pair is already implicitly
  // tenant-scoped. A duplicate grant for the same (agent, tool) pair
  // is nonsensical regardless of tenantId, so tenantId doesn't need
  // to be part of the uniqueness constraint itself.
  @@unique([agentId, toolId])
  @@index([tenantId])
  @@map("agent_tool_permissions")
}

model ToolExecution {
  id              String   @id // client generated as both ToolExecution.id and AuditEvent.id will share the same value
  tenantId        String   @map("tenant_id")
  agentId         String   @map("agent_id")
  toolId          String   @map("tool_id")
  status          String   // success | error | timeout | payload_too_large | denied | rate_limited
  inputPreview    Json?    @map("input_preview")
  outputPreview   Json?    @map("output_preview")
  inputTruncated  Boolean  @default(false) @map("input_truncated")
  outputTruncated Boolean  @default(false) @map("output_truncated")
  errorCode       String?  @map("error_code")
  errorMessage    String?  @map("error_message")
  durationMs      Int      @map("duration_ms")
startedAt   DateTime  @map("started_at")   @db.Timestamptz(3)
completedAt DateTime  @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)


  @@index([tenantId, agentId])
  @@index([tenantId, toolId])
  @@index([tenantId, createdAt])
  @@map("tool_executions")
}

model AuditEvent {
  id        String   @id // client generated as both ToolExecution.id and AuditEvent.id will share the same value
  tenantId  String   @map("tenant_id")
  agentId   String?  @map("agent_id")
  userId    String?  @map("user_id")   // unpopulated until a human-action producer exists — PRD §10 stub
  toolId    String?  @map("tool_id")
  eventType String   @map("event_type")
  status    String?
  payload   Json     // the full validated job payload, for forensic completeness
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt, id])
  @@index([tenantId, agentId])
  @@index([tenantId, toolId])
  @@index([tenantId, eventType])
  @@map("audit_events")
}