# Database & Redis (required by schema)
AGENTGATE_DATABASE_URL=postgresql://test:test@localhost:5432/agentgate_test
AGENTGATE_REDIS_URL=redis://localhost:6379

# JWT & Secrets (min 32 chars)
AGENTGATE_JWT_SECRET=thisisatleast32charactersecretkey
AGENTGATE_INVITATION_TOKEN_SECRET=thisisatleast32charactersecretkey

# Hex-encoded 64-character strings (32 bytes in hex)
AGENTGATE_PASSWORD_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AGENTGATE_API_KEY_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AGENTGATE_REFRESH_TOKEN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AGENTGATE_PLATFORM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email
AGENTGATE_APP_BASE_URL=http://localhost:3000
AGENTGATE_EMAIL_PROVIDER=console

# Node environment
AGENTGATE_NODE_ENV=test