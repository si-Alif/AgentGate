{
  "name": "agentgate",
  "version": "0.1.0",
  "description": "Multi-tenant MCP Agent Infrastructure Platform — a gateway that lets AI agents securely authenticate, discover, and invoke registered tools with enforced permissions, rate limits, audit logging, and real-time observability.",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "agent",
    "gateway",
    "multi-tenant",
    "ai",
    "tools",
    "fastify",
    "infrastructure"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "@fastify/sensible": "^6.0.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ajv": "^8.20.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.4.0",
    "pg": "^8.22.0",
    "safe-regex": "^2.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "ioredis": "$ioredis"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/safe-regex": "^1.1.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
