# use .env.example as a template to create your own .env file instead of using this one directly

# PostgreSQL connection string
AGENTGATE_DATABASE_URL=postgresql://agentgate:pa55word@localhost:5432/agentgate

# Redis connection string
AGENTGATE_REDIS_URL=redis://localhost:6379

# JWT signing secret (min 32 chars)
AGENTGATE_JWT_SECRET=change-this-to-a-random-string-at-least-32-chars-long

# AES-256-GCM encryption key (64 hex chars = 32 bytes)
AGENTGATE_PLATFORM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server port (default: 4000)
AGENTGATE_PORT=4000

# Log level: debug | info | warn | error
AGENTGATE_LOG_LEVEL=info

# Environment: development | production | test
AGENTGATE_NODE_ENV=development


AGENTGATE_EMAIL_PROVIDER=console
AGENTGATE_SENDGRID_API_KEY=
AGENTGATE_EMAIL_FROM_ADDRESS=noreply@agentgate.dev
AGENTGATE_EMAIL_FROM_NAME=AgentGate
AGENTGATE_APP_BASE_URL=http://localhost:3000
AGENTGATE_EMAIL_WORKER_CONCURRENCY=5